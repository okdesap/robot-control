# Backend Auswahl
# sim  = Turtlesim
# real = TurtleBot (/cmd_vel)

# Beispiel:
# ROBOT_BACKEND=sim
# ROBOT_BACKEND=real

ROBOT_BACKEND=sim

# Intent-Erkennung
# parse = regelbasiert (deterministisch)
# function_calling = LLM (Ollama) mit JSON-Function-Calls
INTENT_MODE=parse

# Ollama (nur für INTENT_MODE=function_calling)
# OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# STT Defaults (für parse_intent: "vorwärts"/"links"/"rechts")
STT_DEFAULT_LINEAR=0.5
STT_DEFAULT_ANGULAR=0.5

# TTS (optional)
# TTS_ENGINE=auto   # auto | pico2wave | spd-say | espeak
# TTS_PLAYER=paplay # paplay | aplay
# TTS_ENABLED=1
# TTS_LANG=de-DE
